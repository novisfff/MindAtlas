# ============================================
# MindAtlas Docker optional override template
# You can run `docker compose up -d` directly without copying this file.
# If you do copy it to `.env` and change nothing, behavior stays the same.
# Edit it only when you want to override ports, passwords, or advanced defaults.
# ============================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mindatlas

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mindatlas
# Plan 06 private assistant Artifact bucket (must be distinct; no anonymous policy)
ASSISTANT_ARTIFACT_BUCKET=mindatlas-assistant-artifacts

# Neo4j (for LightRAG knowledge graph)
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Frontend
FRONTEND_PORT=3000

# Optional advanced overrides for backend runtime defaults used by Docker Compose.
# Leave these commented to keep the built-in quick-start defaults from docker-compose.yml.
# AI_PROVIDER_FERNET_KEY=b98esSSrtceWc4IUOFGR-f_6I8FfnxtpjjYQZN51RCw=
# LIGHTRAG_ENABLED=true
# LIGHTRAG_WORKER_ENABLED=true
# DOCLING_WORKER_ENABLED=true
# SCHEDULER_ENABLED=true
# LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
# Immutable image/git revision stamped at build time for production skill publication.
# APP_BUILD_REVISION=
# Plan 03 live model capability probe (paid Provider call). Default-disabled.
# AI_MODEL_CAPABILITY_PROBE_ENABLED=false
# Plan 04 main agent feature mode (production default off).
# ASSISTANT_MAIN_AGENT_MODE=off
# Plan 07 durable human Interrupts (default off; pepper blank in examples).
# ASSISTANT_DURABLE_INTERRUPTS_ENABLED=false
# ASSISTANT_INTERRUPT_DEFAULT_TTL_SEC=86400
# ASSISTANT_INTERRUPT_MAX_TTL_SEC=604800
# ASSISTANT_INTERRUPT_COMMENT_MAX_CHARS=4000
# Pass a real pepper only from deployment secret configuration.
# ASSISTANT_INTERRUPT_TOKEN_PEPPER=

# Plan 08 capability ledger + golden write (defaults off / read-only).
# ASSISTANT_CAPABILITY_LEDGER_MODE=legacy_read_only
# ASSISTANT_MAIN_AGENT_WRITE_MODE=off
# ASSISTANT_CAPABILITY_CALL_IDEMPOTENCY_SECRET=
# ASSISTANT_MAIN_AGENT_WRITE_COHORT_DIGEST=
# Guarded reconciliation mutation CLI (default disabled).
# ASSISTANT_CAPABILITY_RECONCILIATION_ENABLED=false
# Server-owned UUID required only when reconciliation is enabled.
# ASSISTANT_CAPABILITY_RECONCILIATION_OPERATOR_ID=
# ASSISTANT_CAPABILITY_RECONCILIATION_EVIDENCE_SECRET=

# ---------------------------------------------------------------------------
# Single-operator control plane (Plan 1) — production/staging required.
# No defaults. Generate values in an operator-controlled terminal only:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#   python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Never commit real Setup tokens, HMAC key material, passwords, or cookies.
# Backup the session HMAC key ring before rotation; revoke previous-key
# sessions before removing the previous key from the ring.
# ---------------------------------------------------------------------------
# MINDATLAS_CANONICAL_ORIGIN=https://atlas.example
# MINDATLAS_INITIAL_SETUP_TOKEN=
# MINDATLAS_SESSION_HMAC_ACTIVE_KEY_ID=
# MINDATLAS_SESSION_HMAC_KEYS=
# CORS must include the exact canonical origin (no wildcards with credentials).
# CORS_ORIGINS=https://atlas.example
