    {
      "nodeId": "llm_report",
      "nodeType": "llm",
      "label": "Generate Weekly Report",
      "positionX": 980,
      "positionY": 280,
      "config": {
        "systemPrompt": "Generate a concise and grounded weekly report for MindAtlas in English. Base the output on the provided period metadata, retrieved entries, and activity analysis. The summary should focus on the week's key progress and themes. Suggestions must be an array of actionable English strings. Trends should summarize recurring patterns, changes, or signals worth watching. Do not speculate beyond the available data.",
        "userInput": "Report period: {{start.periodType}}\nStart date: {{start.periodStart}}\nEnd date: {{start.periodEnd}}\nEntry count: {{start.entryCount}}\n\nEntries:\n{{tool_entries.result}}\n\nActivity analysis:\n{{tool_activity.result}}",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "summary",
            "type": "string",
            "nullable": false
          },
          {
            "name": "suggestions",
            "type": "array",
            "itemsType": "string",
            "nullable": false
          },
          {
            "name": "trends",
            "type": "string",
            "nullable": false
          }
        ]
      }
    },
    {
      "nodeId": "output_final",
      "nodeType": "output",
