            "description": "Inclusive report period end date in YYYY-MM-DD format."
          },
          {
            "name": "entryCount",
            "type": "integer",
            "required": true,
            "description": "Number of entries in the current period."
          }
        ]
      }
    },
    {
      "nodeId": "tool_entries",
      "nodeType": "tool",
      "label": "Load Entries",
      "positionX": 520,
      "positionY": 200,
      "config": {
        "toolName": "get_entries_by_time_range",
        "inputBindings": {
