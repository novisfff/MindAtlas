      "config": {
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "summary",
            "type": "string",
            "nullable": false,
            "value": "{{llm_report.summary}}"
          },
          {
            "name": "suggestions",
            "type": "array",
            "itemsType": "string",
            "nullable": false,
