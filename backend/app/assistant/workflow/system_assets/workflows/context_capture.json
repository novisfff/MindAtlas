            "name": "type_code"
          },
          {
            "name": "tags",
            "type": "array",
            "items_type": "string"
          },
          {
            "name": "time_mode",
            "enum": [
              "POINT",
              "RANGE"
            ]
          },
          {
            "name": "time_at",
            "nullable": true
          },
          {
            "name": "time_from",
            "nullable": true
          },
          {
