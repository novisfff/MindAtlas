    {
      "nodeId": "code_pick_top1",
      "nodeType": "code_executor",
      "label": "保留 top1 候选",
      "positionX": 2130.0,
      "positionY": 320.0,
      "config": {
        "language": "python",
        "code": "def main(status=None, message=None, items=None):\n    candidates = items if isinstance(items, list) else []\n    top1 = candidates[0] if candidates else {}\n    return {\n        'candidate_count': len(candidates),\n        'candidate_found': bool(top1),\n        'top1_candidate': top1,\n        'search_status': str(status or '').strip(),\n        'search_message': str(message or '').strip(),\n    }\n",
        "entrypoint": "main",
        "inputBindings": {
          "status": "{{tool_search_similar.status}}",
          "message": "{{tool_search_similar.message}}",
          "items": "{{tool_search_similar.items}}"
        },
        "outputFields": [
          {
            "name": "candidate_count",
            "type": "integer"
          },
          {
            "name": "candidate_found"
          },
          {
            "name": "top1_candidate",
            "type": "object"
          },
          {
            "name": "search_status"
          },
          {
            "name": "search_message"
          }
        ]
      }
    },
    {
      "nodeId": "llm_decide",
      "nodeType": "llm",
      "label": "判定新建或合并",
      "positionX": 2540.0,
      "positionY": 320.0,
      "config": {
        "systemPrompt": "你是 MindAtlas 的保守同记录判定器，负责在 create 与 merge 之间做单目标决策。这里的向量召回只负责找候选，不负责证明‘就是同一条记录’。你只能基于 top1_candidate 做一次非常保守的二元判断。\n\n输入含义：\n- original_context：调用方提交的候选记录或记录修正上下文。\n- lookup_hints：从上下文中提炼出的语义召回查询和同记录判断线索。\n- draft_entry：准备入库的最终字段草稿。\n- top1_candidate：语义召回返回的第一候选；它可能只是主题相近，并不一定真的是同一条记录。\n- candidate_found：是否真的存在 top1_candidate。\n\n硬性规则：\n- 如果没有 top1_candidate，必须输出 action=create。\n- 只有当 original_context、draft_entry、same_record_clues 与 top1_candidate 共同明确支持“这是同一条 durable record”时，才允许 action=merge。\n- 只要出现以下任一情况，就必须 create：只是主题相近、同一项目但不同子任务/交付物、同一客户但不同单子/阶段、同一人物但不同事件/行程/申请、同一主题但不同发生次数、时间/主体/结论明显冲突、关键对象对不上、证据不足、你拿不准。\n- 因为这条链路没有人工确认，所以宁可多建一条，也不要错并。\n- entry_id 只能从 top1_candidate.id 中选择；当 action=create 时 entry_id 必须为 null。\n- reason 用简短自然语言说明为什么 merge 或为什么保守 create，尤其要点出稳定主体是否一致，以及最大的匹配点或排除点。\n- 不要输出分数，也不要输出置信度字段。",
        "userInput": "date: {{sys.date}}\nsource: {{sys.request_source}}\nchannel: {{sys.request_channel}}\nsession: {{sys.request_session}}\n\nlookup_hints:\n{{llm_prepare_lookup.response}}\n\ndraft_entry:\n{{llm_materialize.response}}\n\nsearch_status:\n{{code_pick_top1.search_status}}\n\nsearch_message:\n{{code_pick_top1.search_message}}\n\ncandidate_found:\n{{code_pick_top1.candidate_found}}\n\ntop1_candidate:\n{{code_pick_top1.top1_candidate}}\n\noriginal_context:\n{{start.context}}",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "action",
            "enum": [
              "create",
              "merge"
            ]
          },
          {
            "name": "entry_id",
            "nullable": true
          },
          {
            "name": "reason"
          }
        ]
      }
    },
