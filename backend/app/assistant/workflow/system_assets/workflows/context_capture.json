            "name": "title"
          },
          {
            "name": "summary"
          },
          {
            "name": "content"
          },
          {
            "name": "type_code"
          },
          {
            "name": "tags",
            "type": "array",
            "items_type": "string"
          },
          {
            "name": "time_mode",
            "enum": [
              "POINT",
              "RANGE"
            ]
