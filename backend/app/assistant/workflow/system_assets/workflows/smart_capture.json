    {
      "nodeId": "code_prepare_write_payload",
      "nodeType": "code_executor",
      "label": "整理待确认写入内容",
      "positionX": 5280.0,
      "positionY": 320.0,
      "config": {
        "language": "python",
        "code": "def _clean(value):\n    return str(value or '').strip()\n\ndef _pick(action, create_value, merge_value):\n    if action == 'merge_existing' and merge_value not in (None, ''):\n        return merge_value\n    return create_value\n\ndef _pick_list(action, create_value, merge_value):\n    candidate = _pick(action, create_value, merge_value)\n    return candidate if isinstance(candidate, list) else []\n\ndef main(\n    candidate_count=None,\n    triage_action=None,\n    merge_target=None,\n    existing_title=None,\n    create_title=None,\n    create_summary=None,\n    create_content=None,\n    create_type_code=None,\n    create_tags=None,\n    create_time_mode=None,\n    create_time_at=None,\n    create_time_from=None,\n    create_time_to=None,\n    merge_title=None,\n    merge_summary=None,\n    merge_content=None,\n    merge_type_code=None,\n    merge_tags=None,\n    merge_time_mode=None,\n    merge_time_at=None,\n    merge_time_from=None,\n    merge_time_to=None,\n):\n    try:\n        count_value = int(candidate_count or 0)\n    except Exception:\n        count_value = 0\n    action_text = _clean(triage_action)\n    merge_target_id = _clean(merge_target)\n    action = 'merge_existing' if action_text == 'merge_existing' and merge_target_id else 'create_new'\n    existing_entry_title = _clean(existing_title)\n\n    if action == 'merge_existing':\n        confirm_title = '确认合并后的记录'\n        confirm_instruction = (\n            f\"你选择把当前输入合并到已有记录《{existing_entry_title or '未命名记录'}》。\"\n            '请确认下面的整合结果，批准后会更新该已有记录。'\n        )\n        approve_label = '确认合并更新'\n        reject_label = '取消更新'\n        cancel_message = '已取消这次合并更新，原有记录保持不变。'\n    elif count_value > 0:\n        confirm_title = '确认新建独立记录'\n        confirm_instruction = (\n            '你在相似候选中选择了“新建一条记录”。请确认下面的记录内容，'\n            '批准后会创建一条新的独立记录，不会合并到已有记录。'\n        )\n        approve_label = '确认创建'\n        reject_label = '取消创建'\n        cancel_message = '已取消这次新建记录，未写入任何内容。'\n    else:\n        confirm_title = '确认创建新记录'\n        confirm_instruction = '当前没有检索到明显相似的已有记录。请确认下面的记录内容，批准后会新建记录。'\n        approve_label = '确认创建'\n        reject_label = '取消创建'\n        cancel_message = '已取消这次新建记录，未写入任何内容。'\n\n    return {\n        'action': action,\n        'affected_entry_id': merge_target_id,\n        'confirm_title': confirm_title,\n        'confirm_instruction': confirm_instruction,\n        'approve_label': approve_label,\n        'reject_label': reject_label,\n        'cancel_message': cancel_message,\n        'title': _clean(_pick(action, create_title, merge_title)),\n        'summary': _clean(_pick(action, create_summary, merge_summary)),\n        'content': _clean(_pick(action, create_content, merge_content)),\n        'type_code': _clean(_pick(action, create_type_code, merge_type_code)),\n        'tags': _pick_list(action, create_tags, merge_tags),\n        'time_mode': _clean(_pick(action, create_time_mode, merge_time_mode)),\n        'time_at': _clean(_pick(action, create_time_at, merge_time_at)),\n        'time_from': _clean(_pick(action, create_time_from, merge_time_from)),\n        'time_to': _clean(_pick(action, create_time_to, merge_time_to)),\n    }\n",
        "entrypoint": "main",
