    {
      "nodeId": "code_candidates",
      "nodeType": "code_executor",
      "label": "整理相似候选",
      "positionX": 2080.0,
      "positionY": 320.0,
      "config": {
        "language": "python",
        "code": "def _clean(value):\n    return str(value or '').strip()\n\ndef _time_label(item):\n    mode = _clean(item.get('time_mode')).upper()\n    point = _clean(item.get('time_at'))\n    start = _clean(item.get('time_from'))\n    end = _clean(item.get('time_to'))\n    if mode == 'POINT' and point:\n        return point[:10]\n    if mode == 'RANGE' and (start or end):\n        if start and end:\n            return f'{start[:10]} ~ {end[:10]}'\n        return start[:10] or end[:10]\n    return ''\n\ndef _normalize(item, source, index):\n    if not isinstance(item, dict):\n        return None\n    entry_id = _clean(item.get('id'))\n    title = _clean(item.get('title'))\n    if not entry_id or not title:\n        return None\n    return {\n        'entry_id': entry_id,\n        'title': title,\n        'type_name': _clean(item.get('type')) or _clean(item.get('type_code')),\n        'time_label': _time_label(item),\n        'summary': _clean(item.get('summary')),\n        'rank_score': (100 if source == 'primary' else 40) - index,\n        'sources': {source},\n    }\n\ndef main(primary_items=None, secondary_items=None):\n    merged = {}\n    for source, items in (('primary', primary_items or []), ('secondary', secondary_items or [])):\n        for index, raw in enumerate(items):\n            normalized = _normalize(raw, source, index)\n            if normalized is None:\n                continue\n            key = normalized['entry_id']\n            current = merged.get(key)\n            if current is None:\n                merged[key] = normalized\n                continue\n            current['rank_score'] += normalized['rank_score']\n            current['sources'].update(normalized['sources'])\n            if not current['type_name'] and normalized['type_name']:\n                current['type_name'] = normalized['type_name']\n            if not current['time_label'] and normalized['time_label']:\n                current['time_label'] = normalized['time_label']\n            if not current['summary'] and normalized['summary']:\n                current['summary'] = normalized['summary']\n\n    candidates = []\n    for item in merged.values():\n        source_parts = []\n        if 'primary' in item['sources']:\n            source_parts.append('精确检索')\n        if 'secondary' in item['sources']:\n            source_parts.append('主题检索')\n        description_parts = [part for part in (item['type_name'], item['time_label']) if part]\n        if source_parts:\n            description_parts.append('/'.join(source_parts))\n        if item['summary']:\n            description_parts.append(item['summary'][:48])\n        candidates.append({\n            'entry_id': item['entry_id'],\n            'title': item['title'],\n            'type_name': item['type_name'],\n            'time_label': item['time_label'],\n            'rank_score': item['rank_score'],\n            'option': {\n                'value': item['entry_id'],\n                'label': item['title'],\n                'description': ' | '.join(part for part in description_parts if part) or '相似候选记录',\n            },\n        })\n\n    candidates.sort(key=lambda item: (-item['rank_score'], item['title']))\n    top = candidates[:5]\n    if not top:\n        summary = '未发现明显相似的已有记录。'\n    else:\n        lines = []\n        for index, item in enumerate(top, start=1):\n            extra = ' / '.join(part for part in (item['type_name'], item['time_label']) if part)\n            lines.append(f\"{index}. {item['title']}\" + (f'（{extra}）' if extra else ''))\n        summary = '发现可能相似的已有记录：\\n' + '\\n'.join(lines)\n\n    return {\n        'candidate_count': len(top),\n        'candidate_summary': summary,\n        'merge_target_options': [item['option'] for item in top],\n    }\n",
        "entrypoint": "main",
        "inputBindings": {
          "primary_items": "{{tool_search_primary.items}}",
          "secondary_items": "{{tool_search_secondary.items}}"
        },
        "outputFields": [
          {
            "name": "candidate_count",
            "type": "integer"
          },
          {
            "name": "candidate_summary"
          },
          {
            "name": "merge_target_options",
            "type": "array",
            "itemsType": "object"
          }
        ]
      }
    },
