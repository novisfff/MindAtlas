          {
            "nodeId": "code_build_relation_candidate",
            "nodeType": "code_executor",
            "label": "构造关系选项",
            "config": {
              "language": "python",
              "code": "def _clean(value):\n    return str(value or '').strip()\n\ndef main(choice_id=None, source_entry_id=None, target_entry_id=None, relation_type=None, score=None, target_title=None):\n    try:\n        score_value = float(score or 0.0)\n    except Exception:\n        score_value = 0.0\n    title = _clean(target_title) or _clean(target_entry_id)\n    description = f\"{_clean(relation_type)} · {score_value:.2f}\" if _clean(relation_type) else f\"{score_value:.2f}\"\n    return {\n        'candidate': {\n            'value': _clean(choice_id),\n            'label': title,\n            'description': description,\n            'choice_id': _clean(choice_id),\n            'source_entry_id': _clean(source_entry_id),\n            'target_entry_id': _clean(target_entry_id),\n            'target_entry_title': title,\n            'relation_type': _clean(relation_type),\n            'score': score_value,\n        }\n    }\n",
              "entrypoint": "main",
              "inputBindings": {
                "choice_id": "{{code_unpack_relation_candidate.choice_id}}",
                "source_entry_id": "{{code_unpack_relation_candidate.source_entry_id}}",
                "target_entry_id": "{{code_unpack_relation_candidate.target_entry_id}}",
                "relation_type": "{{code_unpack_relation_candidate.relation_type}}",
                "score": "{{code_unpack_relation_candidate.score}}",
                "target_title": "{{tool_get_relation_target.title}}"
              },
              "outputFields": [
                {
                  "name": "candidate",
                  "type": "object"
                }
              ]
            }
          }
