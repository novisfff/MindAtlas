            "nodeId": "code_unpack_relation_candidate",
            "nodeType": "code_executor",
            "label": "解析推荐项",
            "config": {
              "language": "python",
              "code": "def _clean(value):\n    return str(value or '').strip()\n\ndef _as_mapping(value):\n    return value if isinstance(value, dict) else {}\n\ndef main(item=None, source_entry_id=None):\n    payload = _as_mapping(item)\n    relation_type = _clean(payload.get('relationType') or payload.get('relation_type'))\n    target_entry_id = _clean(payload.get('targetEntryId') or payload.get('target_entry_id'))\n    if not relation_type or not target_entry_id:\n        raise ValueError('typed relation recommendation is required')\n    try:\n        score = float(payload.get('score') or 0.0)\n    except Exception:\n        score = 0.0\n    return {\n        'choice_id': f\"{relation_type}:{target_entry_id}\",\n        'source_entry_id': _clean(source_entry_id),\n        'target_entry_id': target_entry_id,\n        'relation_type': relation_type,\n        'score': score,\n    }\n",
              "entrypoint": "main",
              "inputBindings": {
                "item": "{{container.item}}",
                "source_entry_id": "{{code_normalize_persisted.entry_id}}"
              },
              "outputFields": [
