            "nodeId": "code_resolve_selected_relation",
            "nodeType": "code_executor",
            "label": "解析选中关系",
            "config": {
              "language": "python",
              "code": "def _clean(value):\n    return str(value or '').strip()\n\ndef _as_list(value):\n    return value if isinstance(value, list) else []\n\ndef _as_mapping(value):\n    return value if isinstance(value, dict) else {}\n\ndef main(selected_id=None, candidates=None):\n    target_choice = _clean(selected_id)\n    for item in _as_list(candidates):\n        candidate = _as_mapping(item)\n        if not candidate:\n            continue\n        choice_id = _clean(candidate.get('choice_id') or candidate.get('value'))\n        if choice_id != target_choice:\n            continue\n        return {\n            'source_entry_id': _clean(candidate.get('source_entry_id')),\n            'target_entry_id': _clean(candidate.get('target_entry_id')),\n            'relation_type': _clean(candidate.get('relation_type')),\n        }\n    raise ValueError(f'unknown selected relation: {target_choice}')\n",
              "entrypoint": "main",
              "inputBindings": {
                "selected_id": "{{container.item}}",
                "candidates": "{{iter_relation_details.items}}"
              },
              "outputFields": [
