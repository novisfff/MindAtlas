      "label": "Generate Summary",
      "positionX": 1310.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and generating a structured field before persistence.\nCurrent task: generate the final summary field from the user's original content.\nRules: the summary should be a 50-150 word paragraph that captures the core idea.",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "summary"
          }
        ]
      }
    },
    {
      "nodeId": "llm_content",
      "nodeType": "llm",
      "label": "Generate Content",
      "positionX": 1720.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and generating a structured field before persistence.\nCurrent task: generate the final content field from the user's original content.\nRules: Markdown is allowed. Do not use an H1 heading (#). Do not expand or invent factual details the user did not provide.",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "content"
          }
        ]
      }
    },
    {
      "nodeId": "llm_type",
      "nodeType": "llm",
      "label": "Choose Type",
      "positionX": 2130.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and selecting an entry type for persistence.\nCurrent task: choose the final type_code.\nConstraint: type_code must be selected from the codes in {{tool_types.result}} only (a JSON array with code/name fields). If the type is unclear, choose the first available code.",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "type_code"
          }
        ]
      }
    },
    {
      "nodeId": "llm_tags",
      "nodeType": "llm",
      "label": "Generate Tags",
      "positionX": 2540.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and generating tags for persistence.\nCurrent task: produce the final tags field as comma-separated tag text.\nConstraints: reuse names from {{tool_tags.result}} whenever they match semantically or case-insensitively, and prefer the original spelling from the list. You may add at most 5 new tags. Avoid weak filler tags, do not prepend #, and remove duplicates.",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "tags"
          }
        ]
      }
    },
    {
      "nodeId": "llm_time",
      "nodeType": "llm",
      "label": "Resolve Time",
      "positionX": 2950.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and identifying time fields for persistence.\nCurrent task: determine time_mode plus the relevant date fields.\nRules:\n- If the user does not provide clear time information, default to time_mode=POINT and time_at=today (YYYY-MM-DD).\n- For POINT, fill time_at and set time_from/time_to to null.\n- For RANGE, fill time_from/time_to in YYYY-MM-DD format with time_from <= time_to, and set time_at to null.",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "time_mode",
            "enum": [
              "POINT",
              "RANGE"
            ]
          },
          {
            "name": "time_at",
            "nullable": true
          },
          {
            "name": "time_from",
            "nullable": true
          },
          {
            "name": "time_to",
            "nullable": true
          }
        ]
      }
    },
    {
      "nodeId": "human_confirm",
      "nodeType": "human_in_loop",
      "label": "Human Confirmation",
      "positionX": 3360.0,
      "positionY": 306.0,
      "config": {
        "title": "Confirm Entry Creation",
        "instruction": "Please review the generated fields below. Approve to create the entry, or reject to cancel this creation.",
        "approveLabel": "Create Entry",
        "rejectLabel": "Cancel",
        "requireRejectComment": false,
        "fields": [
          {
            "name": "title",
            "label": "Title",
            "type": "string",
            "widget": "input",
