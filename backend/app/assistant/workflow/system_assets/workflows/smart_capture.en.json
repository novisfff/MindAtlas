            "type": "string",
            "widget": "select",
            "optionsTemplate": "{{tool_types.result}}",
            "optionValueKey": "code",
            "required": false,
            "valueTemplate": "{{llm_type.type_code}}"
          },
          {
            "name": "tags",
            "label": "Tags",
            "type": "array",
