            "optionsTemplate": "{{tool_tags.result}}",
            "optionValueKey": "name",
            "allowCustom": true,
            "required": false,
            "valueTemplate": "{{llm_tags.tags}}"
          },
          {
            "name": "time_mode",
            "label": "Time Mode",
            "type": "string",
            "widget": "radio",
            "options": [
              "POINT",
              "RANGE"
            ],
            "required": false,
            "valueTemplate": "{{llm_time.time_mode}}"
          },
          {
            "name": "time_at",
            "label": "Point Date",
            "type": "string",
            "widget": "date",
            "required": false,
            "valueTemplate": "{{llm_time.time_at}}"
          },
          {
            "name": "time_from",
            "label": "Start Date",
            "type": "string",
            "widget": "date",
            "required": false,
            "valueTemplate": "{{llm_time.time_from}}"
          },
          {
            "name": "time_to",
            "label": "End Date",
            "type": "string",
            "widget": "date",
            "required": false,
            "valueTemplate": "{{llm_time.time_to}}"
          }
        ]
      }
