      "positionX": 900.0,
      "positionY": 306.0,
      "config": {
        "systemPrompt": "You are executing MindAtlas's smart capture skill and generating a structured field before persistence.\nCurrent task: generate the final title field from the user's original content.\nRules: the title should be concise, accurate, and no longer than 30 characters when possible.",
        "outputMode": "structured",
