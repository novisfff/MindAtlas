          },
          {
            "name": "timeHint",
            "type": "string",
            "required": false,
            "description": "Natural-language time hint."
          },
          {
            "name": "tagHints",
            "type": "array",
            "itemsType": "string",
            "required": false,
            "description": "Candidate tag list."
          }
        ]
      }
    },
