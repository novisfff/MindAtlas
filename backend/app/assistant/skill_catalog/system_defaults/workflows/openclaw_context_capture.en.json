        "toolName": "list_tags",
        "inputBindings": {}
      }
    },
    {
      "nodeId": "llm_materialize",
      "nodeType": "llm",
      "label": "Materialize Entry Fields",
      "positionX": 860.0,
      "positionY": 260.0,
      "config": {
        "systemPrompt": "You are MindAtlas's OpenClaw capture materialization workflow. Convert thin external context into final persistence fields.\n\nGoals:\n- Produce the final title, summary, content, type_code, tags, time_mode, and time fields.\n- Do not require the caller to assemble a complete entry schema.\n- Do not invent facts the user did not imply. You may only organize and lightly normalize the submitted context.\n\nConstraints:\n- type_code must be selected from the codes in {{tool_types.result}} only. If unsure, pick the first available code.\n- tags should prefer existing names from {{tool_tags.result}} and combine them with tagHints. Return at most 5 tags. Do not add # prefixes.\n- content should preserve the user's important details and may be organized as Markdown, but it must not fabricate new facts.\n- summary should be one concise paragraph of roughly 50-150 characters.\n- title should be accurate and stay within 30 characters when possible.\n- If timeHint and context do not provide a clear time, default to time_mode=POINT and set time_at=today in YYYY-MM-DD.\n- Use RANGE only when a real time span is present. When time_mode=POINT, time_from/time_to must be null. When time_mode=RANGE, time_at must be null.",
        "userInput": "intent: {{start.intent}}\nsource: {{start.source}}\nsession: {{start.session}}\nchannel: {{start.channel}}\ntaskHint: {{start.taskHint}}\ntimeHint: {{start.timeHint}}\ntagHints: {{start.tagHints}}\n\ncontext:\n{{start.context}}",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "title"
          },
          {
            "name": "summary"
          },
          {
            "name": "content"
          },
          {
            "name": "type_code"
          },
          {
            "name": "tags",
            "type": "array",
            "items_type": "string"
          },
          {
            "name": "time_mode",
            "enum": [
              "POINT",
              "RANGE"
            ]
          },
          {
            "name": "time_at",
            "nullable": true
          },
          {
            "name": "time_from",
            "nullable": true
          },
          {
            "name": "time_to",
            "nullable": true
          }
        ]
      }
    },
    {
      "nodeId": "tool_create",
      "nodeType": "tool",
      "label": "Create Entry",
      "positionX": 1290.0,
      "positionY": 260.0,
      "config": {
