            "name": "context",
            "type": "string",
            "required": true,
            "description": "Raw context that should be submitted into MindAtlas."
          },
          {
            "name": "source",
            "type": "string",
            "required": false,
            "description": "Caller source, such as openclaw or chat."
          },
          {
            "name": "session",
            "type": "string",
            "required": false,
            "description": "Conversation session identifier."
