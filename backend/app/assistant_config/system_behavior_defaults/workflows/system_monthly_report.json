{
  "nodes": [
    {
      "nodeId": "start",
      "nodeType": "start",
      "label": "Start",
      "positionX": 120,
      "positionY": 280,
      "config": {
        "inputMode": "structured",
        "memoryMode": "off",
        "structuredFields": [
          {
            "name": "periodType",
            "type": "string",
            "required": true,
            "description": "Report period type."
          },
          {
            "name": "periodStart",
            "type": "string",
            "required": true,
            "description": "Inclusive period start date in YYYY-MM-DD."
          },
          {
            "name": "periodEnd",
            "type": "string",
            "required": true,
            "description": "Inclusive period end date in YYYY-MM-DD."
          },
          {
            "name": "entryCount",
            "type": "integer",
            "required": true,
            "description": "Number of entries within the period."
          }
        ]
      }
    },
    {
      "nodeId": "tool_entries",
      "nodeType": "tool",
      "label": "Load Entries",
      "positionX": 520,
      "positionY": 200,
      "config": {
        "toolName": "get_entries_by_time_range",
        "inputBindings": {
          "start_date": "{{start.periodStart}}",
          "end_date": "{{start.periodEnd}}"
        }
      }
    },
    {
      "nodeId": "tool_activity",
      "nodeType": "tool",
      "label": "Analyze Activity",
      "positionX": 520,
      "positionY": 360,
      "config": {
        "toolName": "analyze_activity",
        "inputBindings": {
          "start_date": "{{start.periodStart}}",
          "end_date": "{{start.periodEnd}}"
        }
      }
    },
    {
      "nodeId": "llm_report",
      "nodeType": "llm",
      "label": "Compose Monthly Report",
      "positionX": 980,
      "positionY": 280,
      "config": {
        "systemPrompt": "Generate a concise monthly report for MindAtlas. Base the result on the provided period metadata, the fetched entries, and the activity analysis. Emphasize longer-running patterns and next-step suggestions. Suggestions must be actionable strings. Trends should highlight notable themes for the month.",
        "userInput": "Report period: {{start.periodType}}\nStart: {{start.periodStart}}\nEnd: {{start.periodEnd}}\nEntry count: {{start.entryCount}}\n\nEntries:\n{{tool_entries.result}}\n\nActivity analysis:\n{{tool_activity.result}}",
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "summary",
            "type": "string",
            "nullable": false
          },
          {
            "name": "suggestions",
            "type": "array",
            "itemsType": "string",
            "nullable": false
          },
          {
            "name": "trends",
            "type": "string",
            "nullable": false
          }
        ]
      }
    },
    {
      "nodeId": "output_final",
      "nodeType": "output",
      "label": "Output",
      "positionX": 1420,
      "positionY": 280,
      "config": {
        "outputMode": "structured",
        "outputFields": [
          {
            "name": "summary",
            "type": "string",
            "nullable": false,
            "value": "{{llm_report.summary}}"
          },
          {
            "name": "suggestions",
            "type": "array",
            "itemsType": "string",
            "nullable": false,
            "value": "{{llm_report.suggestions}}"
          },
          {
            "name": "trends",
            "type": "string",
            "nullable": false,
            "value": "{{llm_report.trends}}"
          }
        ]
      }
    }
