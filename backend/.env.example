# App
APP_NAME=MindAtlas API
APP_ENV=development
DEBUG=true
# Immutable image/git revision in staging/production. Local/test may keep "development".
APP_BUILD_REVISION=development
# Plan 03 live model capability probe (paid Provider call). Default-disabled.
# confirmProviderCall=true is cost acknowledgement only, not authentication.
AI_MODEL_CAPABILITY_PROBE_ENABLED=false

# Emergency process ceiling. Durable rollout control must also allow new Runs.
# Legacy runtime selector env vars are removed and rejected by Settings.
ASSISTANT_NEW_RUNS_ENABLED=true
# Writes remain disabled until Plan 4 release qualification.
ASSISTANT_MAIN_AGENT_WRITE_MODE=off
# Deployment acceptance (not Compose depends_on): curl --fail http://localhost:8000/ready
# Process liveness / Compose bootstrap: GET /health (database-free).
# Optional bounded ceilings (may only lower hard max constants in config.py).
# ASSISTANT_MAIN_AGENT_CATALOG_TOP_K=8
# ASSISTANT_MAIN_AGENT_MAX_ACTIVE_SKILLS=4
# ASSISTANT_MAIN_AGENT_RESOURCE_CHUNK_BYTES=16384
# ASSISTANT_MAIN_AGENT_RESOURCE_MAX_BYTES_PER_CALL=65536
# ASSISTANT_MAIN_AGENT_ARTIFACT_MAX_BYTES=1048576
# ASSISTANT_MAIN_AGENT_ARTIFACT_RUN_MAX_BYTES=5242880
# ASSISTANT_MAIN_AGENT_INLINE_RESULT_BYTES=16384

# Plan 06 durable worker / private Artifact storage.
# ASSISTANT_WORKER_POLL_INTERVAL_MS=500
# ASSISTANT_WORKER_LEASE_TTL_SEC=30
# ASSISTANT_WORKER_HEARTBEAT_INTERVAL_SEC=5
# ASSISTANT_WORKER_REGISTRATION_TTL_SEC=20
# ASSISTANT_WORKER_MAX_RECOVERY_ATTEMPTS=5
# ASSISTANT_WORKER_RETRY_BASE_MS=500
# ASSISTANT_WORKER_RETRY_MAX_MS=30000
# Private Artifact bucket (must be distinct from MINIO_BUCKET; never public-download).
ASSISTANT_ARTIFACT_BUCKET=mindatlas-assistant-artifacts
# ASSISTANT_ARTIFACT_INLINE_MAX_BYTES=262144
# ASSISTANT_ARTIFACT_MAX_BYTES=26214400
# ASSISTANT_ARTIFACT_RUN_MAX_BYTES=104857600
# ASSISTANT_ARTIFACT_ORPHAN_SCAN_INTERVAL_SEC=60
# ASSISTANT_ARTIFACT_ORPHAN_GRACE_SEC=900
# ASSISTANT_DURABLE_CLOCK_SKEW_SEC=30

# Plan 07 durable human Interrupts (default off; pepper blank in examples).
ASSISTANT_DURABLE_INTERRUPTS_ENABLED=false
# ASSISTANT_INTERRUPT_DEFAULT_TTL_SEC=86400
# ASSISTANT_INTERRUPT_MAX_TTL_SEC=604800
# ASSISTANT_INTERRUPT_COMMENT_MAX_CHARS=4000
# Required nonempty stable pepper when interrupts are enabled. Never commit a real value.
ASSISTANT_INTERRUPT_TOKEN_PEPPER=

# Capability ledger + pre-GA create-entry write gate (defaults off / read-only).
# ASSISTANT_CAPABILITY_LEDGER_MODE=legacy_read_only
# ASSISTANT_MAIN_AGENT_WRITE_MODE=off
# Required (>=32 bytes) when ledger mode is enforced or write mode is create_entry.
# ASSISTANT_CAPABILITY_CALL_IDEMPOTENCY_SECRET=
# Guarded reconciliation mutations authenticate the Operator from the Session.
ASSISTANT_CAPABILITY_RECONCILIATION_ENABLED=false
# HMAC secret (>=32 bytes) used only by trusted evidence issuers/verifiers.
# ASSISTANT_CAPABILITY_RECONCILIATION_EVIDENCE_SECRET=

# API
API_PREFIX=/api

# Database (PostgreSQL)
# Reference default: postgresql://postgres:postgres@localhost:5432/mindatlas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindatlas

# CORS
# Comma-separated list; leave empty to disable CORS middleware.
# Production/staging: must include the exact MINDATLAS_CANONICAL_ORIGIN and must not be "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Single-operator control plane (Plan 1)
# ---------------------------------------------------------------------------
# Production/staging require HTTPS termination in front of the app and an exact
# Origin/CORS agreement: CORS_ORIGINS must include MINDATLAS_CANONICAL_ORIGIN
# (no wildcards when credentials are enabled).
#
# Session HMAC key-ring operations (operators only, never automated from CI):
#   1. Backup the current key ring before any rotation.
#   2. Rotate by adding a new active key and retaining the previous key
#      (active + at most one previous; every decoded key >= 32 bytes).
#   3. After sessions have rotated onto the active key, revoke any sessions that
#      still depend on the previous key (revoke_unverifiable_sessions /
#      maintenance path) BEFORE removing the previous key from the ring.
#   4. If initial-session cookie issuance after Setup initialization fails, the
#      browser is fail-closed to /login — recover via normal password login.
# Never commit real Setup tokens, HMAC key material, passwords, or cookies.
# ---------------------------------------------------------------------------
# Canonical browser Origin (scheme + host [+ port]). Production/staging must be HTTPS.
# Example local: http://localhost:3000
# Example production: https://atlas.example
MINDATLAS_CANONICAL_ORIGIN=
# One-time Setup Token for first initialization. Min 32 UTF-8 bytes.
# Generate (prints to an operator-controlled terminal; do not pipe into the repo):
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Never commit a real value. Unusable after initialization commits.
MINDATLAS_INITIAL_SETUP_TOKEN=
# Active key id present in MINDATLAS_SESSION_HMAC_KEYS JSON object.
MINDATLAS_SESSION_HMAC_ACTIVE_KEY_ID=
# JSON object of 1–2 Base64 keys (each decodes to >=32 bytes). Active + at most one previous.
# Generate one key (operator-controlled terminal only):
#   python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Example shape (placeholders only — never reuse, never commit real material):
#   {"k1":"<base64-32-plus-bytes>"}
# Never commit real key material.
MINDATLAS_SESSION_HMAC_KEYS=

# MinIO (S3-compatible object storage for attachments — public download policy)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mindatlas
MINIO_SECURE=false

# AI (runtime config, optional)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# AI Provider storage (Fernet encryption key for API keys)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_PROVIDER_FERNET_KEY=

# LightRAG (knowledge graph indexing)
LIGHTRAG_ENABLED=false
LIGHTRAG_WORKER_ENABLED=false
LIGHTRAG_WORKER_POLL_INTERVAL_MS=2000
LIGHTRAG_WORKER_BATCH_SIZE=50
LIGHTRAG_WORKER_MAX_ATTEMPTS=6
LIGHTRAG_WORKER_LOCK_TTL_SEC=300
LIGHTRAG_WORKING_DIR=./lightrag_storage
LIGHTRAG_WORKSPACE=
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_LLM_MODEL=gpt-4o-mini
# Advanced (OpenAI-compatible): set MODEL/HOST/KEY in one value (JSON)
# LIGHTRAG_LLM_MODEL='{"MODEL":"gpt-4o-mini","HOST":"https://api.openai.com/v1","KEY":"sk-..."}'
# Or override host/key separately:
# LIGHTRAG_LLM_HOST=https://api.openai.com/v1
# LIGHTRAG_LLM_KEY=sk-...
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
# Advanced (OpenAI-compatible): set MODEL/HOST/KEY in one value (JSON)
# LIGHTRAG_EMBEDDING_MODEL='{"MODEL":"text-embedding-3-small","HOST":"https://api.openai.com/v1","KEY":"sk-..."}'
# Or override host/key separately:
# LIGHTRAG_EMBEDDING_HOST=https://api.openai.com/v1
# LIGHTRAG_EMBEDDING_KEY=sk-...
LIGHTRAG_EMBEDDING_DIM=1536

# LightRAG Query API (Phase 5)
LIGHTRAG_AI_KEY_SOURCE=env_or_db
LIGHTRAG_QUERY_TIMEOUT_SEC=60
LIGHTRAG_QUERY_MAX_CONCURRENCY=4
LIGHTRAG_QUERY_CACHE_TTL_SEC=3600
LIGHTRAG_QUERY_CACHE_MAXSIZE=128

# LightRAG Language (optional)
# Controls prompt language for summarization/entity extraction inside LightRAG.
# Example: English | Chinese
LIGHTRAG_SUMMARY_LANGUAGE=Chinese

# LightRAG Rerank (optional)
# Standard rerank API (vLLM/LiteLLM compatible). If MODEL+HOST are set, rerank is enabled automatically.
# If HOST endswith "/v1", backend will append "/rerank" (so "/v1/rerank" is also fine).
LIGHTRAG_RERANK_MODEL=
LIGHTRAG_RERANK_HOST=
LIGHTRAG_RERANK_KEY=
LIGHTRAG_RERANK_TIMEOUT_SEC=15
# standard | aliyun
LIGHTRAG_RERANK_REQUEST_FORMAT=standard
LIGHTRAG_RERANK_ENABLE_CHUNKING=false
LIGHTRAG_RERANK_MAX_TOKENS_PER_DOC=480
LIGHTRAG_MIN_RERANK_SCORE=0.0

# Neo4j (required when LIGHTRAG_ENABLED=true and using Neo4JStorage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Docling Worker (attachment parsing for knowledge graph)
# Parses PDF, Office docs, images (OCR) and indexes text to knowledge graph
DOCLING_WORKER_ENABLED=false
DOCLING_WORKER_POLL_INTERVAL_MS=2000
DOCLING_WORKER_BATCH_SIZE=1
DOCLING_WORKER_MAX_ATTEMPTS=3
DOCLING_WORKER_LOCK_TTL_SEC=600
DOCLING_MAX_FILE_SIZE_MB=100
DOCLING_MAX_PDF_PAGES=500

# Docling OCR (RapidOCR, CPU optimized)
DOCLING_OCR_ENABLED=true
DOCLING_OCR_FORCE_FULL_PAGE_OCR=false
DOCLING_OCR_LANGS=english,chinese

# Docling Picture Description (remote VLM via OpenAI-compatible API)
# Enable only if you have a VLM that supports image_url data URIs
DOCLING_PICTURE_DESCRIPTION_ENABLED=false
# Accepts base URL or full endpoint (auto-normalized to /v1/chat/completions)
# DOCLING_PICTURE_DESCRIPTION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DOCLING_PICTURE_DESCRIPTION_API_KEY=sk-xxx
# DOCLING_PICTURE_DESCRIPTION_MODEL=qwen-vl-max
DOCLING_PICTURE_DESCRIPTION_PROMPT=请简要描述这张图片的内容；如果是图表请提取关键数据。
DOCLING_PICTURE_DESCRIPTION_TIMEOUT_SEC=60
DOCLING_PICTURE_DESCRIPTION_CONCURRENCY=1
# Optional JSON merged into request payload (e.g. {"max_tokens":256})
# DOCLING_PICTURE_DESCRIPTION_PARAMS_JSON=

# Server
HOST=0.0.0.0
PORT=8000

# Schema family/runtime compatibility
# Must be development, rehearsal, or production; never inferred from hostname.
MINDATLAS_DEPLOYMENT_CLASS=development
# APP_BUILD_REVISION is defined in the App section above and is the single
# immutable build label used by runtime identity and rebaseline reports.

# Test-only destructive root downgrade acknowledgement (never set in deployment).
# MINDATLAS_TEST_ALLOW_EMPTY_SCHEMA_DOWNGRADE=I_ACKNOWLEDGE_EMPTY_SCHEMA_DESTRUCTION
